# ==============================================================================
# TitanCore Community Edition - Environment Configuration Template
# ==============================================================================
# Copy this file to .env.local or set system environment variables before launch.
# In local/offline standalone mode, all these values can be left empty.

# Primary Server Seed Node URLs (Optional, supports plain URL or TITAN- obfuscated string)
TITAN_NODE_1=
TITAN_NODE_2=
TITAN_NODE_3=

# Cryptographic Salts & Secret Keys (For custom backend integration)
TITAN_SALT=TITAN_COMMUNITY_DEFAULT_SALT
TITAN_PROTOCOL_SALT=TITAN_COMMUNITY_PROTOCOL
TITAN_CLIENT_SECRET=TITAN_COMMUNITY_CLIENT_SECRET
TITAN_DEPOT_SECRET=

# Optional Manifest Nodes & Archive Endpoints
TITAN_MANIFEST_NODE_1=
TITAN_MANIFEST_NODE_2=
TITAN_MANIFEST_NODE_3=
TITAN_MANIFEST_ARCHIVE_URL=
VITE_PATCH_COMMUNITY_URL=

# Local Development Settings
PORT=5173
NODE_ENV=development
